# BVHUB v3 deployment configuration
#
# Copy this file only if you need local overrides:
#   cp .env.example .env.deploy.local
#
# Then load it before running the deployment script:
#   set -a
#   source ./.env.deploy.local
#   set +a
#   ./build_deploy.sh
#
# Add .env.deploy.local to .gitignore. Do not store passwords, PocketBase
# superuser credentials, tokens, or encryption keys in this file.

# SSH host alias from ~/.ssh/config.
BVHUB_DEPLOY_HOST=verein-server

# Frontend deployment target and healthcheck configuration.
BVHUB_REMOTE_ROOT=/var/www/bvhub-v3
BVHUB_PUBLIC_HOST=v2.bv-erlangen2025.de
BVHUB_FRONTEND_PORT=23010
BVHUB_KEEP_RELEASES=5

# Production PocketBase API used by the frontend and public healthcheck.
BVHUB_POCKETBASE_URL=https://data-v3.bv-erlangen2025.de

# Dedicated BVHUB v3 PocketBase instance.
# The script intentionally rejects the legacy service and port 8090.
BVHUB_POCKETBASE_PORT=18099
BVHUB_POCKETBASE_SERVICE=bvhub-v3-pocketbase.service
BVHUB_POCKETBASE_REMOTE_APP=/opt/bvhub-v3/app/pocketbase
BVHUB_POCKETBASE_DATA=/var/lib/bvhub-v3/pb_data
BVHUB_POCKETBASE_USER=bvhub-v3

# Backups are created before newly detected migrations are started.
BVHUB_BACKUP_ROOT=/var/backups/bvhub-v3
BVHUB_KEEP_BACKUPS=5

# Branch allowed to deploy. Update this deliberately after merging or when
# starting another approved deployment branch.
BVHUB_REQUIRED_BRANCH=feat/wu-05-venues-events-admin-crud

# Local isolated PocketBase integration tests.
BVHUB_TEST_PORT=18101
BVHUB_SKIP_POCKETBASE_TESTS=0

# Set to 1 only for a build/test without SSH deployment.
BVHUB_LOCAL_ONLY=0

# Set to 1 once if obsolete frontend files still exist directly below
# /var/www/bvhub-v3. Keep 0 during normal deployments.
BVHUB_CLEAN_LEGACY_ROOT=0

# Usually unnecessary. The script detects the repository root automatically.
# BVHUB_REPO_ROOT=/root/vibecoding/BVHUB_v2